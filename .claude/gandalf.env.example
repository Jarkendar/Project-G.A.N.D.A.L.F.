# G.A.N.D.A.L.F. environment configuration
# Copy this file to .claude/gandalf.env and set the values.
# .claude/gandalf.env is gitignored — never commit it.

# Path to the brain/ knowledge repository.
# Relative to the root of this project, or absolute.
# Example (sibling directory): ../brain
# Example (absolute): /home/user/repos/brain
BRAIN_PATH=../brain

# G.I.M.L.I. — extra SQLite sources outside brain/db/ (read-only, comma-separated paths).
# brain/db/*.db are discovered automatically from BRAIN_PATH; list only external DBs here.
# Example: /home/user/repos/dev-tracker/dev_tracker.db,/home/user/repos/other/data.db
GIMLI_EXTRA_DBS=

# Strava API (OAuth) — create an app at https://www.strava.com/settings/api
# (Authorization Callback Domain = localhost). These are SECRETS.
# Real values go only in .claude/gandalf.env (gitignored) — never commit them.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: pre-seed tokens to skip the browser bootstrap. Normally leave empty —
# the server bootstraps OAuth and manages these in ~/.config/strava-mcp/config.json.
# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=

# B.I.L.B.O. — embedding model and chunker for brain/index/bilbo.db (read by
# index.py and by the post-commit hook). Model: a key of MODEL_REGISTRY in
# .claude/scripts/bilbo/index.py. Changing any of these three needs a one-off
# `index.py --rebuild`. Values are taken literally — no quotes around the JSON.
BILBO_EMBED_MODEL=granite-311m
BILBO_CHUNKER=v2
BILBO_CHUNK_PARAMS={"skip_lines": "^> (Source|Source URL|CIK|Living document|Ostatnia aktualizacja|Legenda źródeł)"}
