# G.A.N.D.A.L.F. environment configuration
# Copy this file to .claude/gandalf.env and set the values.
# .claude/gandalf.env is gitignored — never commit it.

# Path to the brain/ knowledge repository.
# Relative to the root of this project, or absolute.
# Example (sibling directory): ../brain
# Example (absolute): /home/user/repos/brain
BRAIN_PATH=../brain

# G.I.M.L.I. — extra SQLite sources outside brain/db/ (read-only, comma-separated paths).
# brain/db/*.db are discovered automatically from BRAIN_PATH; list only external DBs here.
# Example: /home/user/repos/dev-tracker/dev_tracker.db,/home/user/repos/other/data.db
GIMLI_EXTRA_DBS=

# Strava API (OAuth) — create an app at https://www.strava.com/settings/api
# (Authorization Callback Domain = localhost). These are SECRETS.
# Real values go only in .claude/gandalf.env (gitignored) — never commit them.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: pre-seed tokens to skip the browser bootstrap. Normally leave empty —
# the server bootstraps OAuth and manages these in ~/.config/strava-mcp/config.json.
# STRAVA_ACCESS_TOKEN=
# STRAVA_REFRESH_TOKEN=

# B.I.L.B.O. — where the index lives (read by index.py, the post-commit hook
# and Samwise): "<qdrant url>/<collection>", e.g. http://127.0.0.1:6333/bilbo
# (the server: imladris-rag/docker-compose.yml), or a SQLite path relative to
# brain/. Empty = index/bilbo.db (SQLite). Moving an existing index between
# the two: imladris.store.copy_store, no re-embedding.
BILBO_INDEX=

# Embedding model and chunker for the index. Model: a key of MODEL_REGISTRY in
# imladris-rag/imladris/models.py. Changing any of these three needs a one-off
# `index.py --rebuild`. Values are taken literally — no quotes around the JSON.
BILBO_EMBED_MODEL=granite-311m
BILBO_CHUNKER=v2
BILBO_CHUNK_PARAMS={"skip_lines": "^> (Source|Source URL|CIK|Living document|Ostatnia aktualizacja|Legenda źródeł)"}

# Enrichment use: "doc" adds a document-level vector per file (title, topics,
# keywords and summary from one Haiku call per changed file, run through
# `claude -p` on the subscription and cached in brain/index/enrichment.db);
# Samwise's --context ranks lead files with it. Empty = no LLM calls at all.
# Changing it needs a one-off `index.py --rebuild`.
BILBO_ENRICHMENT_USE=doc

# S.A.M.W.I.S.E. — optional cross-encoder that reorders the top 20 blocks of a
# ranked search: a key of RERANKER_REGISTRY in imladris-rag/imladris/rerank.py
# (bge-m3, pl-base). Empty = off. Leave it off on a Raspberry Pi: bge-m3 takes
# ~52 s per query there. `search.py --rerank KEY|off` overrides it per call.
SAMWISE_RERANKER=

# S.A.M.W.I.S.E. MCP server — seconds without a query before its worker
# process (model + index, ~2.2 GB) is shut down; the next query starts a new
# one (~15 s). 0 = keep it loaded. Default 600.
SAMWISE_IDLE_UNLOAD=
