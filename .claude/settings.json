{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/smeagol/log-turn.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-instruction-sync/sync.py",
            "timeout": 45
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/samwise-warmup/warmup.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-instruction-sync/sync.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/brain-instruction-sync/sync.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__samwise__context",
      "mcp__samwise__search",
      "mcp__arwen__list_decks",
      "mcp__arwen__find_notes",
      "mcp__gimli__databases",
      "mcp__gimli__schema",
      "mcp__gimli__query",
      "mcp__ori__status",
      "mcp__ori__commit",
      "mcp__frodo__fitness_upsert",
      "mcp__frodo__now",
      "mcp__elrond__record",
      "mcp__mirdain__status",
      "mcp__mirdain__catalog_put",
      "mcp__mirdain__fetch",
      "mcp__mirdain__prepare",
      "mcp__mirdain__assemble",
      "mcp__mirdain__verify_quotes",
      "mcp__mirdain__validation_put",
      "mcp__mirdain__validation_start",
      "mcp__mirdain__validation_status",
      "mcp__thorin__read_export",
      "mcp__thorin__archive_export",
      "mcp__thorin__edgar_reports",
      "mcp__sync__pull",
      "mcp__sync__status",
      "mcp__sync__log",
      "mcp__sync__checkout_main",
      "mcp__rpi__systemd_cat",
      "mcp__rpi__systemd_status",
      "mcp__rpi__systemd_timers",
      "mcp__rpi__journal_tail",
      "mcp__rpi__tmux_ls"
    ]
  }
}
