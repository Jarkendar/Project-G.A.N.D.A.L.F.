# S.A.M.W.I.S.E. MCP server over HTTP — one shared process for every Claude
# Code session (and later n8n), so the Pi holds one copy of the model.
# Install (user service, the account lingers so it starts at boot):
#   systemctl --user enable --now "$PWD/.claude/scripts/samwise/samwise-mcp.service"
# Clients: {"type": "http", "url": "http://127.0.0.1:8765/mcp"} (.mcp.json).
[Unit]
Description=S.A.M.W.I.S.E. - brain/ retrieval as MCP tools (127.0.0.1:8765/mcp)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/github/second_brain/Project-G.A.N.D.A.L.F.
ExecStart=%h/github/second_brain/Project-G.A.N.D.A.L.F./.claude/scripts/bilbo/.venv/bin/python .claude/scripts/samwise/mcp_server.py --transport http
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
