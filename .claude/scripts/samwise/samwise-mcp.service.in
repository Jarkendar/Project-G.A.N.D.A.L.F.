# S.A.M.W.I.S.E. MCP server over HTTP — one shared process for every Claude
# Code session (and later n8n), so the Pi holds one copy of the model.
# A template: install-service.sh fills in @REPO_DIR@ and installs it as a
# user service. Clients: {"type": "http", "url": "http://127.0.0.1:8765/mcp"}.
[Unit]
Description=S.A.M.W.I.S.E. - brain/ retrieval as MCP tools (127.0.0.1:8765/mcp)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/.claude/scripts/bilbo/.venv/bin/python .claude/scripts/samwise/mcp_server.py --transport http
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
