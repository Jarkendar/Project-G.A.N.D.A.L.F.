{
  "mcpServers": {
    "strava": {
      "command": "bash",
      "args": [
        "-c",
        "set -a; . ./.claude/gandalf.env 2>/dev/null; set +a; export PATH=\"$HOME/.bun/bin:$PATH\"; PKG=@r-huijts/strava-mcp-server; if command -v npx >/dev/null 2>&1; then exec npx -y \"$PKG\"; elif command -v bunx >/dev/null 2>&1; then exec bunx -y \"$PKG\"; else echo \"strava-mcp: neither npx nor bunx found on PATH\" >&2; exit 127; fi"
      ]
    },
    "samwise": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp"
    },
    "arwen": {
      "command": "bash",
      "args": [
        "-c",
        "exec .claude/scripts/arwen/.venv/bin/python .claude/scripts/arwen/mcp_server.py"
      ]
    },
    "gimli": {
      "command": "bash",
      "args": [
        "-c",
        "exec .claude/scripts/gimli/.venv/bin/python .claude/scripts/gimli/mcp_server.py"
      ]
    },
    "ori": {
      "command": "bash",
      "args": [
        "-c",
        "exec .claude/scripts/gimli/.venv/bin/python .claude/scripts/ori/mcp_server.py"
      ]
    },
    "frodo": {
      "command": "bash",
      "args": [
        "-c",
        "exec .claude/scripts/gimli/.venv/bin/python .claude/scripts/frodo/mcp_server.py"
      ]
    },
    "elrond": {
      "command": "bash",
      "args": [
        "-c",
        "exec .claude/scripts/gimli/.venv/bin/python .claude/scripts/elrond/mcp_server.py"
      ]
    },
    "thorin": {
      "command": "bash",
      "args": [
        "-c",
        "exec .claude/scripts/gimli/.venv/bin/python .claude/scripts/thorin/mcp_server.py"
      ]
    }
  }
}
